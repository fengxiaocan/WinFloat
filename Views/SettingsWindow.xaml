<Window x:Class="WinFloat.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinFloat 设置"
        Width="560"
        Height="640"
        MinWidth="560"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <CheckBox x:Name="StartWithWindowsCheckBox" Content="开机自动启动" Margin="0,0,0,12" />
                        <CheckBox x:Name="ShowOnStartupCheckBox" Content="启动后直接显示悬浮窗" Margin="0,0,0,12" />
                        <CheckBox x:Name="AlwaysOnTopCheckBox" Content="始终置顶" Margin="0,0,0,12" />
                        <CheckBox x:Name="LockWindowCheckBox" Content="锁定悬浮窗位置" Margin="0,0,0,12" />
                        <CheckBox x:Name="ClickThroughCheckBox" Content="鼠标穿透（可通过托盘关闭）" Margin="0,0,0,16" />

                        <TextBlock Text="双击悬浮窗" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox x:Name="DoubleClickComboBox" SelectedIndex="0" Width="260" HorizontalAlignment="Left">
                            <ComboBoxItem Tag="OpenSettings" Content="打开设置" />
                            <ComboBoxItem Tag="ToggleMinimalMode" Content="切换极简模式" />
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="显示">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="布局方向" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox x:Name="OrientationComboBox" Width="260" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <ComboBoxItem Tag="Vertical" Content="纵向" />
                            <ComboBoxItem Tag="Horizontal" Content="横向" />
                        </ComboBox>

                        <TextBlock Text="主题" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox x:Name="ThemeComboBox" Width="260" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <ComboBoxItem Tag="Dark" Content="深色" />
                            <ComboBoxItem Tag="Light" Content="浅色" />
                            <ComboBoxItem Tag="System" Content="跟随系统（默认深色）" />
                        </ComboBox>

                        <TextBlock Text="背景" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox x:Name="BackgroundComboBox" Width="260" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <ComboBoxItem Tag="Always" Content="背景常显" />
                            <ComboBoxItem Tag="Transparent" Content="背景透明" />
                            <ComboBoxItem Tag="Hover" Content="鼠标经过显示背景" />
                        </ComboBox>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="透明度" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="40" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Margin="14,0,10,0" ValueChanged="OpacitySlider_OnValueChanged" />
                            <TextBlock x:Name="OpacityValueText" Grid.Column="2" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="字体大小" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox x:Name="FontSizeComboBox" Width="260" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <ComboBoxItem Tag="12" Content="小（12px）" />
                            <ComboBoxItem Tag="14" Content="中（14px）" />
                            <ComboBoxItem Tag="16" Content="大（16px）" />
                            <ComboBoxItem Tag="18" Content="18px" />
                            <ComboBoxItem Tag="20" Content="20px" />
                        </ComboBox>

                        <ComboBox x:Name="SpeedUnitComboBox" Width="260" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <ComboBoxItem Tag="Auto" Content="网速单位：自动" />
                            <ComboBoxItem Tag="Kilobytes" Content="网速单位：KB/s" />
                            <ComboBoxItem Tag="Megabytes" Content="网速单位：MB/s" />
                        </ComboBox>
                        <CheckBox x:Name="RoundedCornersCheckBox" Content="使用圆角窗口" Margin="0,0,0,12" />
                        <CheckBox x:Name="CompactModeCheckBox" Content="极简模式（隐藏温度）" Margin="0,0,0,12" />
                        <CheckBox x:Name="HighlightThresholdsCheckBox" Content="启用负载 / 温度颜色提示" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="监控项目">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="显示项目" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <CheckBox x:Name="ShowDownloadCheckBox" Content="下载速度" Margin="0,0,0,10" />
                        <CheckBox x:Name="ShowUploadCheckBox" Content="上传速度" Margin="0,0,0,10" />
                        <CheckBox x:Name="ShowCpuUsageCheckBox" Content="CPU 使用率" Margin="0,0,0,10" />
                        <CheckBox x:Name="ShowCpuTemperatureCheckBox" Content="CPU 温度" Margin="0,0,0,10" />
                        <CheckBox x:Name="ShowMemoryUsageCheckBox" Content="内存使用率" Margin="0,0,0,10" />
                        <CheckBox x:Name="ShowGpuUsageCheckBox" Content="GPU 使用率" Margin="0,0,0,10" />
                        <CheckBox x:Name="ShowGpuTemperatureCheckBox" Content="GPU 温度" Margin="0,0,0,18" />

                        <TextBlock Text="网络适配器" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox x:Name="NetworkAdapterComboBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id" Margin="0,0,0,14" />

                        <TextBlock Text="GPU" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox x:Name="GpuAdapterComboBox" DisplayMemberPath="DisplayName" SelectedValuePath="Name" Margin="0,0,0,14" />

                        <TextBlock Text="刷新频率" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox x:Name="RefreshIntervalComboBox" Width="260" HorizontalAlignment="Left">
                            <ComboBoxItem Tag="500" Content="500ms" />
                            <ComboBoxItem Tag="1000" Content="1000ms（推荐）" />
                            <ComboBoxItem Tag="2000" Content="2000ms" />
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="88" Height="32" Margin="0,0,8,0" Click="CancelButton_OnClick" />
            <Button Content="保存" Width="88" Height="32" IsDefault="True" Click="SaveButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
