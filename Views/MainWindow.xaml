<Window x:Class="WinFloat.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinFloat"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        SourceInitialized="Window_OnSourceInitialized"
        Loaded="Window_OnLoaded"
        Closing="Window_OnClosing"
        LocationChanged="Window_OnLocationChanged">
    <Border x:Name="RootBorder"
            Padding="10,8"
            BorderThickness="1"
            MouseEnter="RootBorder_OnMouseEnter"
            MouseLeave="RootBorder_OnMouseLeave"
            PreviewMouseLeftButtonDown="RootBorder_OnMouseLeftButtonDown"
            PreviewMouseLeftButtonUp="RootBorder_OnMouseLeftButtonUp">
        <Grid>
            <StackPanel x:Name="VerticalPanel" Orientation="Vertical">
                <Grid x:Name="VerticalNetworkRow" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VerticalDownloadText" Grid.Column="0" />
                    <TextBlock Text="|" Grid.Column="1" Opacity="0.35" HorizontalAlignment="Center" />
                    <TextBlock x:Name="VerticalUploadText" Grid.Column="2" />
                </Grid>
                <Grid x:Name="VerticalCpuRow" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VerticalCpuUsageText" Grid.Column="0" />
                    <TextBlock x:Name="VerticalCpuTemperatureText" Grid.Column="2" />
                </Grid>
                <TextBlock x:Name="VerticalMemoryText" Margin="0,0,0,4" />
                <Grid x:Name="VerticalGpuRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VerticalGpuUsageText" Grid.Column="0" />
                    <TextBlock x:Name="VerticalGpuTemperatureText" Grid.Column="2" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="HorizontalPanel" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock x:Name="HorizontalDownloadText" />
                <TextBlock x:Name="HorizontalUploadText" Margin="10,0,0,0" />
                <TextBlock Text="|" Margin="10,0" Opacity="0.35" />
                <TextBlock x:Name="HorizontalCpuUsageText" />
                <TextBlock x:Name="HorizontalCpuTemperatureText" Margin="6,0,0,0" />
                <TextBlock Text="|" Margin="10,0" Opacity="0.35" />
                <TextBlock x:Name="HorizontalMemoryText" />
                <TextBlock Text="|" Margin="10,0" Opacity="0.35" />
                <TextBlock x:Name="HorizontalGpuUsageText" />
                <TextBlock x:Name="HorizontalGpuTemperatureText" Margin="6,0,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
